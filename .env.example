# --- Supabase (Postgres + Auth) ---
# Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the browser. Used for metering,
# Stripe webhooks, and admin endpoints (bypasses Row Level Security).
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5 if unset
ANTHROPIC_MODEL=claude-sonnet-5
# $ per million tokens — verify against https://docs.claude.com/en/docs/about-claude/pricing
ANTHROPIC_INPUT_COST_PER_MTOK=3
ANTHROPIC_OUTPUT_COST_PER_MTOK=15

# --- OpenAI (Whisper transcription for video analysis + TTS "Read Aloud") ---
OPENAI_API_KEY=
# $ per minute of audio — verify against https://openai.com/api/pricing
WHISPER_COST_PER_MINUTE=0.006
# $ per million characters for the tts-1 model — verify against https://openai.com/api/pricing
TTS_COST_PER_MILLION_CHARS=15

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# A recurring (yearly interval) Price ID for the 12-month membership
STRIPE_MEMBERSHIP_PRICE_ID=

# --- Resend (transactional email — member login credentials) ---
# https://resend.com/api-keys — requires a verified sending domain, see https://resend.com/domains
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "Pitch Perfect AI <noreply@pitchperfectai.co>"
RESEND_FROM_EMAIL=

# --- App ---
# Used to build Stripe Checkout success/cancel URLs, and links in member emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Guardrails (optional overrides — see src/lib/credits.ts) ---
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=30
